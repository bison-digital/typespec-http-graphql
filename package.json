{
	"name": "typespec-http-graphql",
	"version": "0.2.0",
	"description": "TypeSpec emitter: generate the GraphQL surface a spec declares, as a graphql-js schema and its SDL, whose resolvers call the same handlers, validated by the same Zod schemas, as a generated HTTP server.",
	"keywords": [
		"codegen",
		"graphql",
		"openapi",
		"typespec",
		"typespec-emitter",
		"zod"
	],
	"homepage": "https://github.com/bison-digital/typespec-http-graphql#readme",
	"bugs": {
		"url": "https://github.com/bison-digital/typespec-http-graphql/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bison-digital/typespec-http-graphql.git"
	},
	"files": [
		"dist/src/**",
		"lib/*.tsp",
		"src/runtime.ts"
	],
	"type": "module",
	"main": "dist/src/index.js",
	"exports": {
		".": {
			"typespec": "./lib/main.tsp",
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		},
		"./runtime": {
			"types": "./dist/src/runtime.d.ts",
			"default": "./dist/src/runtime.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"test": "tsc -p tsconfig.build.json && vitest run",
		"test:unit": "tsc -p tsconfig.build.json && vitest run --project unit",
		"test:mutation": "stryker run && vitest run --config vitest.mutation-check.config.ts",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "oxlint --type-aware -D typescript/no-deprecated src/ test/",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"change-case": "^5.4.4",
		"typespec-http-zod": "^0.34.0"
	},
	"devDependencies": {
		"@apollo/client": "4.3.3",
		"@envelop/core": "5.6.1",
		"@graphql-inspector/core": "8.0.1",
		"@hono/node-server": "2.1.5",
		"@hono/zod-validator": "^0.9.1",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@types/node": "^26.5.1",
		"@typespec/compiler": "1.17.0",
		"@typespec/events": "0.87.0",
		"@typespec/http": "1.17.0",
		"@typespec/http-specs": "0.1.0-alpha.44",
		"@typespec/openapi": "1.17.0",
		"@typespec/openapi3": "1.17.0",
		"@typespec/rest": "0.87.0",
		"@typespec/sse": "0.87.0",
		"@typespec/streams": "0.87.0",
		"@typespec/versioning": "0.87.0",
		"@typespec/xml": "0.87.0",
		"ajv": "8.20.0",
		"graphql": "17.0.2",
		"graphql-http": "1.23.1",
		"graphql-yoga": "5.24.4",
		"hono": "^4.13.7",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"oxlint-tsgolint": "7.0.2004",
		"rxjs": "7.8.2",
		"secure-json-parse": "^4.1.1",
		"typescript": "~7.0.2",
		"typespec-hono": "0.31.0",
		"typespec-http-graphql": "link:",
		"vitest": "^5.0.0",
		"wrangler": "^4.131.1",
		"zod": "^4.6.2"
	},
	"peerDependencies": {
		"@typespec/compiler": "^1.15.0",
		"@typespec/http": "^1.15.0",
		"@typespec/openapi": "^1.15.0",
		"graphql": "^17.0.0",
		"zod": "^4.5.0"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@11.21.0",
	"tspMain": "lib/main.tsp"
}
