node_modules/
dist/

# Emitted output. A glob rather than a list of suite directories: an enumerated list goes stale the
# first time a suite is added, and the failure mode is a generated file committed by accident.
**/.out/
# Per-suite sweep directories: each compiles its own set so it never grades another suite's build.
**/.out-*/

# `pnpm pack` writes here during the packaging oracle.
*.tgz

# IDE state: one machine's editor settings, not the project's.
.idea/
.vscode/
*.iml

# Redirected command output, which carries absolute paths.
*.log

# Generated by the agreement arm.
test/agreement/tsconfig.agreement.json

# Miniflare's local state, written beside the Worker whenever the socket suite starts one.
**/.wrangler/
